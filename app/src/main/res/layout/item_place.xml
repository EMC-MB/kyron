<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:background="@drawable/card_bg"
    android:clipToOutline="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="horizontal"
    android:padding="10dp"
    android:stateListAnimator="@animator/press_scale">

    <!-- Placard tile: score-colored top band over the real OSM map
         thumbnail (or monogram fallback) + condensed score chip.
         transitionName pairs with Detail's hero for the shared grow. -->
    <FrameLayout
        android:id="@+id/placard"
        android:layout_width="84dp"
        android:layout_height="96dp"
        android:background="@drawable/photo_tile"
        android:clipToOutline="true"
        android:transitionName="placard">

        <ImageView
            android:id="@+id/photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/cd_place_map"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/mono"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/font_barlow_condensed"
            android:gravity="center"
            android:textColor="@color/white"
            android:textFontWeight="700"
            android:textSize="34sp" />

        <View
            android:id="@+id/score_band"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="top" />

        <TextView
            android:id="@+id/score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="6dp"
            android:background="@drawable/score_chip"
            android:fontFamily="@font/font_barlow_condensed"
            android:gravity="center"
            android:minWidth="32dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textFontWeight="700"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/star"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="top|end"
            android:layout_margin="5dp"
            android:background="@drawable/star_scrim"
            android:contentDescription="@string/cd_watch"
            android:padding="7dp"
            android:src="@drawable/ic_star_border" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/ink"
            android:textFontWeight="600"
            android:textSize="15.5sp" />

        <TextView
            android:id="@+id/addr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/muted"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/muted"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/why"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="3"
            android:textColor="@color/ink_soft"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
