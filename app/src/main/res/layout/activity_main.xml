<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Header bar: condensed wordmark + the LF-4 region chip + bell.
         The chip is a plain Button — LF-4's entry into Coverage. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/kyron_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/font_barlow_condensed"
            android:letterSpacing="0.06"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textFontWeight="700"
            android:textSize="23sp" />

        <ImageButton
            android:id="@+id/notif_btn"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_alerts"
            android:padding="11dp"
            android:src="@drawable/ic_notifications"
            app:tint="@color/white" />

        <!-- Region chip (LF-4): shows the active region everywhere; tapping
             it opens Coverage, where states are picked/downloaded. The chip
             follows RegionManager, so a switch made in Coverage lands here. -->
        <Button
            android:stateListAnimator="@animator/press_scale"
            android:id="@+id/region_chip"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:minWidth="0dp"
            android:background="@drawable/status_pill"
            android:drawableEnd="@drawable/ic_arrow_drop_down"
            android:drawablePadding="2dp"
            android:drawableTint="@color/kyron_primary"
            android:paddingStart="14dp"
            android:paddingEnd="10dp"
            android:text="@string/region_chip_default"
            android:textAllCaps="false"
            android:textColor="@color/kyron_dark"
            android:textFontWeight="600"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Floating dock + sliding selection indicator that glides under
         the active tab. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:background="@drawable/dock_bg"
            android:elevation="12dp"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <TextView
                android:id="@+id/tab_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/tab_pill"
                android:drawableTop="@drawable/ic_home"
                android:drawablePadding="2dp"
                android:gravity="center"
                android:paddingTop="6dp"
                android:text="@string/nav_home"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tab_browse"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/tab_pill"
                android:drawableTop="@drawable/ic_search"
                android:drawablePadding="2dp"
                android:gravity="center"
                android:paddingTop="6dp"
                android:text="@string/nav_browse"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tab_map"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/tab_pill"
                android:drawableTop="@drawable/ic_map"
                android:drawablePadding="2dp"
                android:gravity="center"
                android:paddingTop="6dp"
                android:text="@string/nav_map"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tab_alerts"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/tab_pill"
                android:drawableTop="@drawable/ic_person"
                android:drawablePadding="2dp"
                android:gravity="center"
                android:paddingTop="6dp"
                android:text="@string/nav_account"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:id="@+id/dock_indicator"
            android:layout_width="26dp"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="7dp"
            android:background="@drawable/tab_indicator"
            android:elevation="13dp" />
    </FrameLayout>
</LinearLayout>
