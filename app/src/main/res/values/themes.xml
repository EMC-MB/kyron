<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- LF4FIX2 bisection: the theme returns to the AppCompat family —
         the same family the device-proven LF-0→LF-3 build (md5
         9f2eab88…) ran on this user's phone. The Material3 parent and
         its color-role items (colorSurface, colorOnPrimaryContainer,
         …) arrived with the 2.1 layer and leave with it; only
         AppCompat/android attributes are used here, so the theme
         resolves entirely from the LF-3-era dependency set. -->
    <style name="Theme.Kyron" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#1E6B38</item>
        <item name="colorPrimaryDark">#123C26</item>
        <item name="colorAccent">#1E6B38</item>
        <item name="colorControlActivated">#1E6B38</item>
        <item name="android:colorBackground">#F7F9F7</item>
        <item name="android:statusBarColor">#123C26</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#F7F9F7</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:fontFamily">@font/font_barlow</item>
        <item name="buttonStyle">@style/KyronButton</item>
        <item name="android:buttonStyle">@style/KyronButton</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="alertDialogTheme">@style/KyronDialog</item>
        <item name="android:dialogTheme">@style/KyronDialog</item>
        <item name="android:spinnerStyle">@style/KyronSpinner</item>
    </style>

    <style name="KyronDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">#1E6B38</item>
        <item name="android:fontFamily">@font/font_barlow</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="buttonBarButtonStyle">@style/KyronButton.Text</item>
        <item name="android:buttonBarButtonStyle">@style/KyronButton.Text</item>
    </style>
</resources>
