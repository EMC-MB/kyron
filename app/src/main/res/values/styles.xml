<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="KyronButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_tonal</item>
        <item name="android:textColor">@color/kyron_primary</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>

    <style name="KyronButton.Primary" parent="KyronButton">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="KyronButton.Text" parent="KyronButton">
        <item name="android:background">@drawable/btn_text_ripple</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="KyronSpinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/spinner_pill</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">34dp</item>
        <item name="android:minHeight">40dp</item>
    </style>
</resources>
